<% layout("./layout") %>
<p><a class="back" href="/family">&larr; Back to the tree</a></p>
<h1>Who can sign in</h1>
<% if (it.error) { %>
<p class="error"><%= it.error %></p>
<% } %>
<% if (it.warning) { %>
<p class="warning"><%= it.warning %></p>
<% } %>
<p class="who">
  Everyone with access to this site. To let someone new sign in, open their card on the tree and
  grant access there &mdash; every account belongs to someone on the tree.
</p>

<% it.rows.forEach(function (persona) { %>
<div class="card">
  <div class="bar"></div>
  <div>
    <a href="/family/<%= persona.personId %>"><%~ include("./_persona-row", { persona: persona }) %></a>
    <form class="inline" method="post" action="/family/accounts/<%= encodeURIComponent(persona.email) %>/role">
      <select name="role">
        <option value="member" <%= persona.role === "member" ? "selected" : "" %>>Member</option>
        <option value="admin" <%= persona.role === "admin" ? "selected" : "" %>>Admin</option>
      </select>
      <button type="submit">Update role</button>
    </form>
    <form
      class="inline"
      method="post"
      action="/family/accounts/<%= encodeURIComponent(persona.email) %>/delete"
      onsubmit="return confirm('Remove their access? They stay on the tree, but can no longer sign in.');"
    >
      <button type="submit">Remove access</button>
    </form>
  </div>
</div>
<% }) %>

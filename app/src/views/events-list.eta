<% layout("./layout") %>
<h1>Family Hub</h1>
<p class="who">Signed in as <strong><%= it.email %></strong>.</p>
<a class="new-btn" href="/events/new">+ New event</a>
<% if (it.events.length === 0) { %>
<p>No upcoming events.</p>
<% } %> <% it.events.forEach(function (event) { %>
<div class="card">
  <div class="bar"></div>
  <div>
    <a href="/events/<%= event.id %>"><%= event.title %></a>
    <div class="when"><%= event.startAt.toLocaleString() %></div>
  </div>
</div>
<% }) %>

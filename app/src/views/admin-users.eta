<% layout("./layout") %>
<p><a class="back" href="/">&larr; Back</a></p>
<h1>Family Members</h1>
<% if (it.isAdmin) { %>
<a class="new-btn" href="/admin/manage">Manage family members</a>
<% } else { %>
<button class="new-btn" type="button" disabled title="You need admin access to manage family members.">Manage family members</button>
<% } %>
<% it.users.forEach(function (u) { %>
<div class="card">
  <div class="bar"></div>
  <div>
    <div><strong><%= u.email %></strong> &mdash; <%= u.role %></div>
  </div>
</div>
<% }) %>

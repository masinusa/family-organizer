<% layout("./layout") %>
<p><a class="back" href="/christmas">&larr; Back to Christmas</a></p>
<h1>Secret Santa <%= it.exchange.year %></h1>
<div class="meta-line when">
  <span><%= it.exchange.count %> <%= it.exchange.count === 1 ? "person" : "people" %></span>
  <span><%= it.exchange.budget ? it.exchange.budget + " budget" : "No budget set" %></span>
  <span><%= it.exchange.date ? "Exchange " + it.exchange.date : "No date set" %></span>
</div>

<% if (it.error) { %>
<p class="error" role="alert"><%= it.error %></p>
<% } %>

<% if (it.isIn) { %>
<section class="santa-reveal">
  <% if (it.recipient) { %>
  <span class="santa-label">You're buying for</span>
  <%~ include("./_persona-avatar", { persona: it.recipient, size: "lg" }) %>
  <strong class="santa-name"><%= it.recipient.name %></strong>
  <span class="hint">Keep it to yourself.</span>
  <% } else { %>
  <span class="santa-label">Names haven't been drawn yet</span>
  <span class="hint">Check back once they have &mdash; you'll see who you're buying for here.</span>
  <% } %>
</section>
<% } else if (it.isAdmin) { %>
<p class="who">You're not taking part this year &mdash; just running it.</p>
<% } %>

<% if (it.isAdmin) { %>
<h2>Run it</h2>

<% if (it.exchange.drawn && it.unassigned.length > 0) { %>
<p class="warning">
  <% it.unassigned.forEach(function (p, i) { %><%= i ? ", " : "" %><%= p.name %><% }) %>
  <%= it.unassigned.length === 1 ? "isn't" : "aren't" %> fully assigned since the list changed.
  Draw again, or fix it by hand in the full list.
</p>
<% } %>

<details class="sheet">
  <summary class="sheet-head">
    <span class="sheet-name">Budget and date</span>
    <span class="sheet-value"><%= it.exchange.budget || "No budget" %> &middot; <%= it.exchange.date || "No date" %></span>
    <span class="sheet-chev"></span>
  </summary>
  <div class="sheet-body">
    <form method="post" action="/christmas/secret-santa/<%= it.exchange.year %>/details">
      <label>
        Budget, in dollars (optional)
        <input type="number" name="budget" min="1" max="10000" step="1" value="<%= it.values.budget %>" />
      </label>
      <label>
        Exchange date (optional)
        <input type="date" name="exchangeDate" value="<%= it.values.exchangeDate %>" />
      </label>
      <button type="submit">Save</button>
    </form>
  </div>
</details>

<details class="sheet">
  <summary class="sheet-head">
    <span class="sheet-name">Who's taking part</span>
    <span class="sheet-value"><%= it.exchange.count %> <%= it.exchange.count === 1 ? "person" : "people" %></span>
    <span class="sheet-chev"></span>
  </summary>
  <div class="sheet-body">
    <form method="post" action="/christmas/secret-santa/<%= it.exchange.year %>/participants">
      <%~ include("./_persona-picker", {
        name: "participantIds",
        legend: "Family and friends",
        personas: it.roster,
        mode: "multi",
        value: "id",
        selected: it.participantIds,
      }) %>
      <p class="hint">
        Friends taking part can sign in to see their part of it, and nothing else. Anyone marked
        &ldquo;not signed in&rdquo; can't see who they drew &mdash; you'll need to tell them.
      </p>
      <button type="submit">Save</button>
    </form>
  </div>
</details>

<form
  method="post"
  action="/christmas/secret-santa/<%= it.exchange.year %>/draw"
  <% if (it.exchange.drawn) { %>onsubmit="return confirm('Draw names again? Everyone gets someone new.');"<% } %>
>
  <button type="submit"><%= it.exchange.drawn ? "Draw names again" : "Draw names" %></button>
</form>
<p class="hint">
  Nobody draws themselves, their partner, or the person they had last year. Nobody sees who got whom
  &mdash; you included &mdash; unless they open the full list below.
</p>

<% if (!it.showAll) { %>
<p><a class="back" href="/christmas/secret-santa/<%= it.exchange.year %>?all=1">Show all assignments (spoilers)</a></p>
<% } else { %>
<h2>All assignments</h2>
<p><a class="back" href="/christmas/secret-santa/<%= it.exchange.year %>">Hide them again</a></p>
<% it.warnings.forEach(function (warning) { %>
<p class="warning"><%= warning %></p>
<% }) %>
<% if (it.participants.length === 0) { %>
<p class="empty-state">Nobody's taking part yet.</p>
<% } else { %>
<form method="post" action="/christmas/secret-santa/<%= it.exchange.year %>/assignments" class="santa-table">
  <% it.participants.forEach(function (giver) { %>
  <label class="santa-row">
    <%~ include("./_persona-row", { persona: giver, subtitle: false }) %>
    <span class="santa-arrow" aria-hidden="true">&rarr;</span>
    <select name="to:<%= giver.personId %>" aria-label="Who <%= giver.name %> buys for">
      <option value="">&mdash; nobody yet &mdash;</option>
      <% it.participants.forEach(function (receiver) { %>
      <% if (receiver.personId !== giver.personId) { %>
      <option value="<%= receiver.personId %>" <%= it.assignments[giver.personId] === receiver.personId ? "selected" : "" %>><%= receiver.name %></option>
      <% } %>
      <% }) %>
    </select>
  </label>
  <% }) %>
  <button type="submit">Save assignments</button>
</form>
<% } %>
<% } %>
<% } %>

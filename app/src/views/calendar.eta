<% layout("./layout") %>
<h1>Calendar</h1>
<a class="new-btn" href="/events/new">+ New event</a>
<div class="cal-header">
  <div class="cal-nav-group">
    <a class="cal-nav" href="/?year=<%= it.prev.year %>&month=<%= it.prev.month %>">&lsaquo; Prev</a>
    <a class="cal-nav cal-today-btn" href="/">Today</a>
  </div>
  <h2 class="cal-title"><%= new Date(it.year, it.month - 1, 1).toLocaleString(undefined, { month: "long", year: "numeric" }) %></h2>
  <a class="cal-nav" href="/?year=<%= it.next.year %>&month=<%= it.next.month %>">Next &rsaquo;</a>
</div>
<div class="cal-grid">
  <% const weekdays = ["Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat"]; %>
  <% weekdays.forEach(function (label) { %>
  <div class="cal-weekday"><%= label %></div>
  <% }) %>
  <% it.grid.forEach(function (week) { %>
  <% week.forEach(function (day) { %>
  <div class="cal-cell<%= day.inCurrentMonth ? "" : " other-month" %><%= day.isToday ? " today" : "" %>">
    <div class="cal-day-num"><%= day.dayOfMonth %></div>
    <% day.events.forEach(function (event) { %>
    <a class="cal-event" href="/events/<%= event.id %>"><%= event.title %></a>
    <% }) %>
  </div>
  <% }) %>
  <% }) %>
</div>

<h2>View as</h2>
<p class="who">
  You're signed in as <strong><%= it.realName %></strong>. Pick somebody to browse as and the whole
  site becomes theirs &mdash; their nav, their permissions, and anything you create is created by
  them.
</p>
<% if (it.options.length === 0) { %>
<p>There are no other accounts to view as yet.</p>
<% } else { %>
<form method="post" action="/impersonate">
  <input type="hidden" name="return" value="<%= it.returnTo %>" />
  <%~ include("./_persona-picker", {
    name: "email",
    legend: "Person",
    personas: it.options,
    mode: "single",
    value: "email",
    selected: it.current ? [it.current] : [],
    required: true,
  }) %>
  <button type="submit">View as this person</button>
</form>
<% } %>
<% if (it.current) { %>
<form method="post" action="/impersonate/stop">
  <input type="hidden" name="return" value="<%= it.returnTo %>" />
  <button class="btn-quiet" type="submit">Back to being me</button>
</form>
<% } %>

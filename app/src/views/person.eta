<% layout("./layout") %>
<p><a class="back" href="/family">&larr; Back to the tree</a></p>

<% if (it.error) { %>
<p class="error"><%= it.error %></p>
<% } %>
<% if (it.warning) { %>
<p class="warning"><%= it.warning %></p>
<% } %>

<div class="person-head">
  <span class="monogram monogram-lg" style="background: <%= it.swatch.tint %>; color: <%= it.swatch.ink %>;"
    ><%= it.initials %></span
  >
  <div>
    <h1><%= it.person.name %></h1>
    <% if (it.person.blurb) { %>
    <p class="person-blurb"><%= it.person.blurb %></p>
    <% } %>
    <% if (it.birthday || it.person.birthYear || it.account) { %>
    <p class="who meta-line">
      <% if (it.birthday) { %><span>&#127874; <%= it.birthday %></span><% } %>
      <% if (it.person.birthYear) { %><span>Born <%= it.person.birthYear %></span><% } %>
      <% if (it.account) { %><span><%= it.account.email %></span><% } %>
    </p>
    <% } %>
  </div>
</div>

<% if (it.canEdit) { %>
<h2>Their details</h2>
<form method="post" action="/family/<%= it.person.id %>/persona">
  <label>
    Name
    <input type="text" name="name" value="<%= it.person.name %>" required />
  </label>
  <label>
    A line about them
    <input type="text" name="blurb" maxlength="60" value="<%= it.person.blurb || '' %>" placeholder="grandma, baker of pies" />
  </label>
  <label>
    Birthday
    <span class="field-row">
      <select name="birthMonth">
        <option value="">&mdash;</option>
        <% it.months.forEach(function (label, i) { %>
        <option value="<%= i + 1 %>" <%= it.person.birthMonth === i + 1 ? "selected" : "" %>><%= label %></option>
        <% }) %>
      </select>
      <select name="birthDay">
        <option value="">&mdash;</option>
        <% for (let d = 1; d <= 31; d++) { %>
        <option value="<%= d %>" <%= it.person.birthDay === d ? "selected" : "" %>><%= d %></option>
        <% } %>
      </select>
    </span>
  </label>
  <label>
    Birth year
    <input
      type="number"
      name="birthYear"
      class="year-input"
      min="<%= it.minBirthYear %>"
      max="<%= it.maxBirthYear %>"
      step="1"
      inputmode="numeric"
      placeholder="1952"
      value="<%= it.person.birthYear || '' %>"
    />
  </label>
  <p class="who field-hint">Either can be left blank &mdash; a birthday without a year, or a year on its own, is fine.</p>
  <fieldset class="persona-swatches">
    <legend>Card color</legend>
    <% it.colors.forEach(function (c) { %>
    <label class="persona-swatch" title="<%= c.label %>">
      <input type="radio" name="color" value="<%= c.key %>" <%= it.person.color === c.key ? "checked" : "" %> />
      <span style="background: <%= c.tint %>; border-color: <%= c.ink %>;"></span>
    </label>
    <% }) %>
  </fieldset>
  <button type="submit">Save</button>
</form>
<% } %>

<% if (it.isAdmin) { %>
<h2>Account</h2>

<% if (it.account) { %>
<div class="link-state is-linked">
  <strong><%= it.account.email %></strong>
  <span>linked &mdash; <%= it.person.name %> can sign in as <%= it.account.role %></span>
</div>
<form method="post" action="/family/<%= it.person.id %>/account" class="account-form">
  <label>
    Role
    <select name="role">
      <option value="member" <%= it.account.role === "member" ? "selected" : "" %>>Member</option>
      <option value="admin" <%= it.account.role === "admin" ? "selected" : "" %>>Admin</option>
    </select>
  </label>
  <div class="actions">
    <button type="submit" name="action" value="grant" class="safe-btn">Update role</button>
    <button
      type="submit"
      name="action"
      value="revoke"
      onclick="return confirm('Remove their access? They stay on the tree, but can no longer sign in.');"
    >
      Remove access
    </button>
  </div>
</form>
<form
  method="post"
  action="/family/<%= it.person.id %>/email"
  class="account-form"
  onsubmit="return confirm('Unlink this account from <%= it.person.name %>? The account keeps working — it just won\'t belong to anyone on the tree.');"
>
  <input type="hidden" name="email" value="" />
  <button type="submit" class="link-btn">Wrong person? Unlink this account</button>
</form>

<% } else { %>
<p class="who">
  <%= it.person.name %> is on the tree but can't sign in yet. Linking is by email: whichever Google
  address you set here is the account they'll sign in with.
</p>

<% if (it.linkableAccounts.length > 0) { %>
<form method="post" action="/family/<%= it.person.id %>/email" class="account-form">
  <label>
    Link an account that already exists
    <select name="email">
      <% it.linkableAccounts.forEach(function (u) { %>
      <option value="<%= u.email %>"><%= u.email %> (<%= u.role %>)</option>
      <% }) %>
    </select>
  </label>
  <button type="submit">Link to <%= it.person.name %></button>
</form>
<p class="who or-divider">or</p>
<% } %>

<form method="post" action="/family/<%= it.person.id %>/email" class="account-form">
  <label>
    <%= it.person.email ? "Their email" : "Set their email" %>
    <input type="text" name="email" value="<%= it.person.email || '' %>" placeholder="name@example.com" />
  </label>
  <button type="submit">Save email</button>
</form>

<% if (it.person.email) { %>
<div class="link-state">
  <strong><%= it.person.email %></strong>
  <span>has no account yet &mdash; grant access to let them sign in.</span>
</div>
<form method="post" action="/family/<%= it.person.id %>/account" class="account-form">
  <label>
    Role
    <select name="role">
      <option value="member">Member</option>
      <option value="admin">Admin</option>
    </select>
  </label>
  <button type="submit" name="action" value="grant">Let them sign in</button>
</form>
<% } %>
<% } %>

<h2>Relationships</h2>
<p class="who">
  A parent runs down the tree; a relationship is a plain line across it &mdash; partners,
  co-parents, anyone who belongs side by side.
</p>

<%
  // Three sources, one list: every link is shown in the same shape, so
  // there is a single place to look. Children are listed for context but
  // edited from the card of the child, which is where that link lives.
  // (Mind the apostrophes: a stray one in a comment inside an Eta tag
  // reads as an opening quote and swallows the closing delimiter.)
  var rows = []
    .concat(
      it.parents.map(function (p) {
        return { kind: "parent", tag: "↑ Parent", person: p, removable: true };
      }),
    )
    .concat(
      it.connections.map(function (p) {
        return { kind: "connection", tag: "↔ Relationship", person: p, removable: true };
      }),
    )
    .concat(
      it.children.map(function (p) {
        return { kind: "child", tag: "↓ Child", person: p, removable: false };
      }),
    );
  var canAddParent = !it.parentsFull && it.parentOptions.length > 0;
  var canAddConnection = it.connectionOptions.length > 0;
%>

<% if (rows.length === 0) { %>
<p class="empty-state">No relationships yet.</p>
<% } else { %>
<ul class="rel-list">
  <% rows.forEach(function (row) { %>
  <li class="rel-row">
    <span class="rel-tag"><%= row.tag %></span>
    <a href="/family/<%= row.person.id %>"><%= row.person.name %></a>
    <% if (row.removable) { %>
    <form method="post" action="/family/<%= it.person.id %>/relationships/remove">
      <input type="hidden" name="kind" value="<%= row.kind %>" />
      <input type="hidden" name="otherId" value="<%= row.person.id %>" />
      <button type="submit" class="link-btn">Remove</button>
    </form>
    <% } else { %>
    <span class="rel-note">edit on their card</span>
    <% } %>
  </li>
  <% }) %>
</ul>
<% } %>

<% if (!canAddParent && !canAddConnection) { %>
<p class="who field-hint">
  <% if (it.parentsFull) { %>Two parents already, and everyone<% } else { %>Everyone<% } %> else on
  the tree is linked to <%= it.person.name %> already.
</p>
<% } else { %>
<form class="rel-add" id="rel-add" method="post" action="/family/<%= it.person.id %>/relationships">
  <label>
    Add a relationship
    <select id="rel-kind" name="kind">
      <option value="parent" <%= canAddParent ? "" : "disabled" %> <%= canAddParent ? "selected" : "" %>>
        Parent &mdash; one or two people above<%= it.parentsFull ? " (already has two)" : "" %>
      </option>
      <option value="connection" <%= canAddConnection ? "" : "disabled" %> <%= canAddParent ? "" : "selected" %>>
        Relationship &mdash; one person alongside
      </option>
    </select>
  </label>

  <% if (canAddParent) { %>
  <div class="rel-fields" data-rel-kind="parent">
    <label>
      Their parent
      <select name="parentIds">
        <option value="">&mdash; choose someone &mdash;</option>
        <% it.parentOptions.forEach(function (p) { %>
        <option value="<%= p.id %>"><%= p.name %></option>
        <% }) %>
      </select>
    </label>
    <% if (it.person.parentIds.length === 0 && it.parentOptions.length > 1) { %>
    <label>
      And their other parent <span class="rel-optional">optional</span>
      <select name="parentIds">
        <option value="">&mdash; nobody &mdash;</option>
        <% it.parentOptions.forEach(function (p) { %>
        <option value="<%= p.id %>"><%= p.name %></option>
        <% }) %>
      </select>
    </label>
    <% } %>
  </div>
  <% } %>

  <% if (canAddConnection) { %>
  <div class="rel-fields" data-rel-kind="connection" <%= canAddParent ? "hidden" : "" %>>
    <label>
      Relationship with
      <select name="connectionId">
        <option value="">&mdash; choose someone &mdash;</option>
        <% it.connectionOptions.forEach(function (p) { %>
        <option value="<%= p.id %>"><%= p.name %></option>
        <% }) %>
      </select>
    </label>
  </div>
  <% } %>

  <button type="submit">Add</button>
</form>
<script>
  // Only the chosen kind's fields are on screen. The inactive group still
  // submits its (empty) select, which is harmless: the route reads the
  // fields that go with the submitted "kind" and ignores the rest.
  (function () {
    var kind = document.getElementById("rel-kind");
    var groups = document.getElementById("rel-add").querySelectorAll("[data-rel-kind]");

    function sync() {
      for (var i = 0; i < groups.length; i += 1) {
        groups[i].hidden = groups[i].getAttribute("data-rel-kind") !== kind.value;
      }
    }

    kind.addEventListener("change", sync);
    sync();
  })();
</script>
<% } %>

<div class="actions">
  <form
    method="post"
    action="/family/<%= it.person.id %>/delete"
    onsubmit="return confirm('Remove <%= it.person.name %> from the tree? Their children keep any other parent, but lose this link.');"
  >
    <button type="submit">Remove from tree</button>
  </form>
</div>
<% } %>

<% layout("./layout") %>
<p><a class="back" href="/admin">&larr; Back to Family Tree</a></p>
<h1>Manage People</h1>
<% if (it.error) { %>
<p class="error"><%= it.error %></p>
<% } %>
<% it.people.forEach(function (p) { %>
<div class="card">
  <div class="bar"></div>
  <div>
    <div>
      <a href="/tree/people/<%= p.id %>/edit"><strong><%= p.name %></strong></a><% if (p.email) { %> &mdash; <%= p.email %><% } %>
    </div>
    <form
      class="inline"
      method="post"
      action="/tree/people/<%= p.id %>/delete"
      onsubmit="return confirm('Remove <%= p.name %> from the tree? Their children will keep any other parent link, but lose this one.');"
    >
      <button type="submit">Remove</button>
    </form>
  </div>
</div>
<% }) %>

<h2>Add a person</h2>
<form method="post" action="/tree/people">
  <label>
    Name
    <input type="text" name="name" required />
  </label>
  <label>
    Email (optional)
    <input type="text" name="email" />
  </label>
  <button type="submit">Add</button>
</form>

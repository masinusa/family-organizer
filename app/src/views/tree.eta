<% layout("./layout") %>
<h1>Family Tree</h1>
<% if (it.isAdmin) { %>
<a class="new-btn" href="/tree/manage">Manage people</a>
<a class="new-btn" href="/admin/manage">Manage family members</a>
<% } else { %>
<button class="new-btn" type="button" disabled title="You need admin access to manage people.">Manage people</button>
<button class="new-btn" type="button" disabled title="You need admin access to manage family members.">Manage family members</button>
<% } %>
<% if (it.layout.cards.length === 0) { %>
<p class="empty-state">
  No one's been added to the tree yet.<% if (it.isAdmin) { %> Use "Manage people" above to add the first person.<% } %>
</p>
<% } else { %>
<div class="tree-canvas" style="width: <%= it.layout.width %>px; height: <%= it.layout.height %>px;">
  <svg class="tree-svg" width="<%= it.layout.width %>" height="<%= it.layout.height %>">
    <% it.layout.connectors.forEach(function (line) { %>
    <line x1="<%= line.x1 %>" y1="<%= line.y1 %>" x2="<%= line.x2 %>" y2="<%= line.y2 %>" />
    <% }) %>
  </svg>
  <% it.layout.cards.forEach(function (card) { %>
  <div class="person-card" style="left: <%= card.x %>px; top: <%= card.y %>px;">
    <span><%= card.person.name %></span>
    <% if (card.person.email) { %>
    <span class="email-icon" title="<%= card.person.email %>">&#9993;</span>
    <% } %>
  </div>
  <% }) %>
</div>
<% } %>

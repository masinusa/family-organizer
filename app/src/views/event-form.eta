<% layout("./layout") %>
<p><a class="back" href="<%= it.returnTo || "/" %>">&larr; Back</a></p>
<h1><%= it.values.id ? "Edit event" : "New event" %></h1>
<% if (it.error) { %>
<p class="error"><%= it.error %></p>
<% } %>
<form method="post" action="<%= it.values.id ? '/events/' + it.values.id : '/events' %>">
  <% if (it.returnTo) { %>
  <input type="hidden" name="return" value="<%= it.returnTo %>" />
  <% } %>
  <%~ include("./_event-fields", it) %>

  <button type="submit">Save</button>
</form>

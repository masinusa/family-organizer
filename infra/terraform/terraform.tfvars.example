project_id   = "elevated-server-509103-u5"
region       = "us-central1"
service_name = "family-hub"
ar_repo_name = "family-hub"
github_repo  = "masinusa/family-organizer"

# Bootstrap/recovery access — the app manages everyone else's IAP access
# directly (see infra/terraform/iap.tf).
bootstrap_admin_email = "admin@example.com"

custom_domain = "yourdomain.example"

billing_account_id   = "01C980-13952D-CD7E56"
budget_amount_usd    = 5
budget_currency_code = "USD"

# Shared mailbox the vault can read recent mail from, for one-time codes.
# Leave empty to turn that feature off. The app password itself is NOT here —
# add it to Secret Manager by hand (see infra/terraform/secrets.tf).
family_mailbox_address = "family@example.com"
